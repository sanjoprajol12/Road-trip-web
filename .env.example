# My Ride Nepal API (Laravel 12) + web SPA build. Copy to .env and fill the blanks:
#   php artisan key:generate
#   set DB_PASSWORD and DB_MIGRATION_PASSWORD to two long random values (e.g. openssl rand -hex 24)
#   pnpm db:start && pnpm db:setup && php artisan migrate --database=pgsql_owner && php artisan db:seed
# Never put real remote credentials here. The SPA has no environment secrets at all.

APP_NAME="My Ride Nepal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Origin of the PUBLIC WEBSITE (admin repo, src/apps/public): email links are built from it and reach the API
# through that site's /api proxy. Development: its Vite dev server (:5180). Production: the public site's domain.
APP_URL=http://127.0.0.1:5180
# Origin of the STAFF app (links in staff invitation emails). Development: its Vite dev server.
ADMIN_URL=http://127.0.0.1:5181

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Local Supabase Postgres. Requests use mrn_app (no DDL, no RLS bypass); migrations use mrn_owner.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=54322
DB_DATABASE=myridenepal
DB_USERNAME=mrn_app
DB_PASSWORD=
DB_MIGRATION_USERNAME=mrn_owner
DB_MIGRATION_PASSWORD=

HASH_DRIVER=argon2id
BCRYPT_ROUNDS=12

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_MAX_MINUTES=10080
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
# Origins whose requests get cookie sessions (web dev, admin dev and preview, Laravel itself).
SANCTUM_STATEFUL_DOMAINS=127.0.0.1:5180,localhost:5180,127.0.0.1:5181,localhost:5181,127.0.0.1:4180,localhost:4180,127.0.0.1:4181,localhost:4181

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Sign-ups per IP per hour (production default 20; raise locally for E2E runs).
AUTH_REGISTER_PER_HOUR=1000

# Local mail catcher (Mailpit, started by `pnpm db:start`): inbox at http://127.0.0.1:54324
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=54325
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@myridenepal.test"
MAIL_FROM_NAME="My Ride Nepal"

# Behind a hosting proxy only (production): comma-separated proxy IPs, or * when the platform has no fixed list.
TRUSTED_PROXIES=
# Every frontend calls the API same-origin through a proxy, so CORS stays closed. Exact origins only if ever needed.
CORS_ALLOWED_ORIGINS=

# Contact form messages per address per hour (raise only for local E2E runs).
CONTACT_PER_HOUR=5

# Uploads (docs/architecture/UPLOAD_SAFETY_DESIGN.md). Development and testing may use the local disk.
UPLOADS_ENABLED=true
# LOCAL_DISK_ROOT=app/private
