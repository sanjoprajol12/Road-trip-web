# Copy to .env (development) and .env.test (tests, database myridenepal_test). Placeholders only.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Runtime connection uses the app role (mrn_app, DML only). Migration credentials never go here (TD-05).
DATABASE_URL=postgres://mrn_app:change-me-app@127.0.0.1:5442/myridenepal_dev
# Public website and staff portal origins (used for links in emails).
APP_URL=http://localhost:5273
ADMIN_URL=http://localhost:5274
