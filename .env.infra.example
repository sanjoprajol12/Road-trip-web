# Local database and mail server passwords, used only by scripts/dev-infra.sh. Copy to .env.infra.
# The superuser and owner passwords never go into .env (the running API uses only the mrn_app role).
POSTGRES_SUPERUSER_PASSWORD=change-me-superuser
MRN_OWNER_PASSWORD=change-me-owner
MRN_APP_PASSWORD=change-me-app
