# Production environment for the Laravel API (names only: values come from the owner's providers and are entered
# in the hosting platform, never committed, never copied from the local .env). See docs/architecture/DEPLOYMENT_READINESS.md.
APP_NAME="My Ride Nepal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Origin of the PUBLIC WEBSITE (admin repo, src/apps/public): email links are built from it and reach the API
# through that site's /api proxy. Development: its Vite dev server (:5180). Production: the public site's domain.
APP_URL=http://127.0.0.1:5180
# Origin of the STAFF app (links in staff invitation emails). Development: its Vite dev server.
ADMIN_URL=http://127.0.0.1:5181

LOG_CHANNEL=stack
LOG_LEVEL=debug

APP_NAME="My Ride Nepal"
APP_ENV=production
APP_DEBUG=false
# php artisan key:generate --show (once; keep it stable: it decrypts stored secret settings)
APP_KEY=
# Public website origin (email links) and staff portal origin (staff invitations and staff password resets)
APP_URL=
ADMIN_URL=
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Production Postgres (owner decision AR5). The app connects as the DML-only role; migrations use the owner role.
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_MIGRATION_USERNAME=
DB_MIGRATION_PASSWORD=
DB_SSLMODE=require

# Sessions and cache in the database (shared by every instance; the container disk is not durable)
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax
CACHE_STORE=database
# No queue worker on serverless containers: run queued work inline until a worker or cron exists
QUEUE_CONNECTION=sync

# Both frontend hosts (exact host names, no scheme)
SANCTUM_STATEFUL_DOMAINS=
TRUSTED_PROXIES=*
CORS_ALLOWED_ORIGINS=

# Mail provider (owner): credentials can also be stored encrypted in Settings > Mail
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Durable file storage (owner decision D1 / O6, still open). App\Support\UploadPolicy refuses new uploads in any
# environment other than local/testing while the chosen disk is "local", logs one critical event an hour, and keeps
# serving existing files. Keep UPLOADS_ENABLED=false until a durable disk is configured and verified; there is no
# setting or variable that lets production write to the local disk.
UPLOADS_ENABLED=false
FILESYSTEM_DISK=local
# When a provider is approved: install its package, set the s3 disk below, allow "s3" in config/settings.php,
# choose it in Staff → Settings → Storage, run "Test storage", then set UPLOADS_ENABLED=true.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=auto
# AWS_BUCKET=
# AWS_ENDPOINT=
# AWS_USE_PATH_STYLE_ENDPOINT=false
